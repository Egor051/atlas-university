# Self-signed local HTTPS test; do not use this configuration on the public VPS.
{
	auto_https disable_redirects
	skip_install_trust
}
https://localhost {
	tls internal
	encode zstd gzip
	@submission_upload {
		method POST
		path_regexp ^/api/learning/assignments/[0-9]+/submit/?$
	}
	@regular_request not {
		path_regexp ^/api/(?:learning/assignments/[0-9]+/submit|materials(?:/[0-9]+)?|direct/dialogs(?:/[0-9]+/messages)?)/?$
	}
	@material_upload path_regexp ^/api/(?:materials(?:/[0-9]+)?|direct/dialogs(?:/[0-9]+/messages)?)/?$
	request_body @submission_upload {
		max_size 2097152
	}
	request_body @material_upload {
		max_size 7340032
	}
	request_body @regular_request {
		max_size 64KB
	}
	# Only this loopback-bound test stack accepts synthetic client addresses.
	# Production Caddyfile never reads this header.
	@probe_client header X-Atlas-Test-IP *
	handle @probe_client {
		reverse_proxy web:8000 {
			header_up X-Forwarded-For {http.request.header.X-Atlas-Test-IP}
		}
	}
	handle {
		reverse_proxy web:8000
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
