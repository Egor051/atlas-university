{$DOMAIN} {
	encode zstd gzip
	@submission_upload {
		method POST
		path_regexp ^/api/learning/assignments/[0-9]+/submit/?$
	}
	@regular_request not {
		method POST
		path_regexp ^/api/learning/assignments/[0-9]+/submit/?$
	}
	request_body @submission_upload {
		max_size 2097152
	}
	request_body @regular_request {
		max_size 64KB
	}
	reverse_proxy web:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# The apex hostname is the canonical origin used by cookies and CSRF checks.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
