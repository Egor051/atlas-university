# Docker HTTPS deployment only. Never commit the actual .env file.
# DOMAIN is a hostname only, with no protocol, path or port.
DOMAIN=campus.example.ru
# Generate a URL-safe random password: python -c "import secrets; print(secrets.token_urlsafe(36))"
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URLSAFE_48_CHAR_PASSWORD
# A DIFFERENT random password for the non-superuser application role.
ATLAS_APP_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_URLSAFE_48_CHAR_PASSWORD
# true keeps the fictional contest accounts. false does not create demo users.
# This concept has no real-user onboarding/SSO: DEMO_MODE=false is an empty deployment.
DEMO_MODE=true
# Each worker has its own connection pool; start small on a 2 GB VPS.
WEB_WORKERS=2
